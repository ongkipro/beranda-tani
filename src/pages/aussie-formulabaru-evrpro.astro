---
/*
 * Native Astro landing page — aussie-formulabaru-evrpro.
 * Duplicate ad slug for `/aussie-formulabaru`; points canonical at it.
 */
import AussieFormulaBaruPage from '../components/storefront/landing-pages/AussieFormulaBaruPage.astro';
import { getStorefrontProduct } from '../lib/catalog';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, 'aussie');
if (!product) return Astro.rewrite('/404');
---

<AussieFormulaBaruPage slug="aussie-formulabaru-evrpro" canonicalSlug="aussie-formulabaru" product={product} />
