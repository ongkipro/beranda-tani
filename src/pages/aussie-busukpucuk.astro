        "time": "09:41"
      },
      {
        "from": "them",
        "photo": {
          "src": "/images/landing/aussie-busukpucuk/wa-karni-ph.webp",
          "width": 640,
          "height": 960
        },
        "time": "09:43"
      },
      {
        "from": "them",
        "text": "Daun menghijau lagi, joss 👍👍",
        "time": "09:43"
      },
      {
