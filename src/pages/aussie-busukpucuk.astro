---
/*
 * Native Astro landing page — aussie-busukpucuk.
 * Ported on 2026-10-19 from https://petanisawit.com/aussie-busukpucuk (Berdu), keeping
 * its slug, so ads already pointing at the old address land on the same page.
 */
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import PetaniSawitLandingShell from '../components/storefront/landing-pages/PetaniSawitLandingShell.astro';
import WhatsAppChat from '../components/storefront/landing-pages/WhatsAppChat.astro';
import { busukPucukChats } from '../data/petanisawit-chats';
import { getStorefrontProduct } from '../lib/catalog';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, 'aussie');
if (!product) return Astro.rewrite('/404');
const liter = product.variants.find((variant) => variant.sku === 'AUSSIE1LITER');

const title = 'AUSSIE Obat Pucuk Busuk Kelapa Sawit';
const description =
  'Atasi pucuk busuk pada kelapa sawit dengan AUSSIE, pupuk cair organik. Botol 1 liter dan 500 ml, bisa COD.';

const topImages = [
  { file: '02.webp', width: 960, height: 1612, n: 2 },
  { file: '03.webp', width: 960, height: 2539, n: 3 },
  { file: '04.webp', width: 960, height: 1445, n: 4 },
  { file: '05.webp', width: 960, height: 1292, n: 5 },
  { file: '06.webp', width: 960, height: 1629, n: 6 },
  { file: '07.webp', width: 960, height: 1827, n: 7 },
  { file: '08.webp', width: 960, height: 1630, n: 8 },
  { file: '09.webp', width: 960, height: 2536, n: 9 },
] as const;
---

<PetaniSawitLandingShell
  slug="aussie-busukpucuk"
  product={product}
  title={title}
  description={description}
  image="/images/landing/aussie-busukpucuk/01.webp"
>
  <h1 class="sr-only">{title}</h1>
  <div class="ps-image">
    <img
      src="/images/landing/aussie-busukpucuk/01.webp"
      width="960"
      height="1406"
      alt={`${title} — gambar 1`}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  {
    topImages.map((img) => (
      <div class="ps-image">
        <img
          src={`/images/landing/aussie-busukpucuk/${img.file}`}
          width={img.width}
          height={img.height}
          alt={`${title} — gambar ${img.n}`}
          loading="lazy"
          decoding="async"
        />
      </div>
    ))
  }
  <section class="ps-wa" style="background-color:#6acb6a">
    <WhatsAppChat {...busukPucukChats.bpKarni} />
  </section>
  <section class="ps-wa" style="background-color:#6acb6a">
    <WhatsAppChat {...busukPucukChats.bpAndi} />
  </section>
  <section class="ps-wa" style="background-color:#6acb6a">
    <WhatsAppChat {...busukPucukChats.bpSuroso} />
  </section>
  <div class="ps-image">
    <img
      src="/images/landing/aussie-busukpucuk/13.webp"
      width="960"
      height="1955"
      alt={`${title} — gambar 10`}
      loading="lazy"
      decoding="async"
    />
  </div>
  <section id="checkout" class="ps-form">
    <GeoIpResolvedForm mode="hybrid" productSlug={product.slug} selectedVariantId={liter?.id} embedded={true} />
  </section>
  <div class="ps-image" style="padding-bottom:35px">
    <img
      src="/images/landing/aussie-formulabaru/12.webp"
      width="960"
      height="291"
      alt={`${title} — gambar 11`}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="ps-image">
    <img
      src="/images/landing/aussie-busukpucuk/14.webp"
      width="960"
      height="116"
      alt={`${title} — gambar 12`}
      loading="lazy"
      decoding="async"
    />
  </div>
</PetaniSawitLandingShell>
