---
/*
 * Native Astro landing page — aussie-buahlandak.
 * Ported on 2026-10-19 from https://petanisawit.com/aussie-buahlandak (Berdu), keeping
 * its slug, so ads already pointing at the old address land on the same page.
 */
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import PetaniSawitLandingShell from '../components/storefront/landing-pages/PetaniSawitLandingShell.astro';
import { getStorefrontProduct } from '../lib/catalog';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, 'aussie');
if (!product) return Astro.rewrite('/404');
const liter = product.variants.find((variant) => variant.sku === 'AUSSIE1LITER');

const title = 'Aussie untuk Tandan Buah Landak Kelapa Sawit - Petani Sejahtera';
const gallery = [
  { file: '02.webp', width: 720, height: 768, n: 2 },
  { file: '03.webp', width: 720, height: 768, n: 3 },
  { file: '04.webp', width: 720, height: 768, n: 4 },
  { file: '05.webp', width: 720, height: 768, n: 5 },
  { file: '06.webp', width: 720, height: 768, n: 6 },
  { file: '07.webp', width: 750, height: 2000, n: 7 },
] as const;
---

<PetaniSawitLandingShell
  slug="aussie-buahlandak"
  product={product}
  title={title}
  description="Atasi tandan sawit landak, buah jarang, dan biji kosong dengan Aussie. Tersedia botol 500 ml dan 1 liter, pesan mudah bisa COD."
  image="/images/landing/aussie-buahlandak/01.webp"
>
  <h1 class="sr-only">{title}</h1>
  <div class="ps-image">
    <a href="#checkout">
      <img
        src="/images/landing/aussie-buahlandak/01.webp"
        width="720"
        height="768"
        alt={`${title} — gambar 1`}
        loading="eager"
        fetchpriority="high"
      />
    </a>
  </div>
  {
    gallery.map((img) => (
      <div class="ps-image">
        <img
          src={`/images/landing/aussie-buahlandak/${img.file}`}
          width={img.width}
          height={img.height}
          alt={`${title} — gambar ${img.n}`}
          loading="lazy"
          decoding="async"
        />
      </div>
    ))
  }
  <section id="checkout" class="ps-form">
    <GeoIpResolvedForm mode="hybrid" productSlug={product.slug} selectedVariantId={liter?.id} embedded={true} />
  </section>
  <section class="ps-text ps-small" style="background-color:#B71C1C;padding-top:8px;padding-bottom:8px">
    <div style="color:#ffffff">
      <h2 class="ps-h2"><em>Hati - hati ! Banyak beredar produk Aussie </em><em><strong>PALSU</strong></em><em> dengan harga lebih murah</em></h2>
      <p><em><strong>Produk Asli Hanya Ada Disini, 100% Original</strong></em></p>
    </div>
  </section>
</PetaniSawitLandingShell>
