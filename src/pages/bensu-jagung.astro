---
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import PetaniSejahteraLandingShell from '../components/storefront/landing-pages/PetaniSejahteraLandingShell.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import { getStorefrontProduct } from '../lib/catalog';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, 'bensu');
if (!product) return Astro.rewrite('/404');

const sectionTitle = 'text-[23px] font-bold leading-[1.18] tracking-tight text-[#0F2A5F]';
const body = 'text-[15px] leading-relaxed text-slate-600';
const listIcon = 'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-[#0F2A5F]';
const dangerIcon = 'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-[#B91C1C]';
---

<PetaniSejahteraLandingShell
  slug="bensu-jagung"
  product={product}
  title="BENSU Jagung - Pemulihan Jagung Kuning, Kerdil & Tongkol Besar"
  description="Atasi jagung kuning, kerdil, daun menggulung, dan pertumbuhan macet meski sudah dipupuk dengan BENSU. Lengkap takaran & jadwal pakai, bisa COD."
  image="/images/landing/bensu-jagung/hero-petani.webp"
>
  <section class="flex flex-col gap-4 bg-white pb-6 pt-[max(1.5rem,env(safe-area-inset-top))] text-left text-slate-950">
    <div class="px-5">
      <h1 class="text-[clamp(22px,6vw,26px)] font-extrabold leading-[1.18] tracking-tight text-slate-950">
        Jagung Kuning, Kerdil & Mogok Tumbuh?{' '}
        <span
          class="box-decoration-clone px-0.5 text-[#0F2A5F]"
          style="background-image: linear-gradient(to top, #FFD84D 0.24em, rgba(255,216,77,0) 0.24em); background-repeat: no-repeat; background-position: 0 94%; background-size: 100% 100%;"
        >
          Selamatkan Lahan Sebelum Gagal Panen Membakar Modal Anda!
        </span>
      </h1>
      <p class="mt-3 text-[clamp(14px,3.6vw,15px)] font-medium leading-relaxed text-slate-700">
        Sudah dihajar urea & NPK tapi tetap pucat? Telat tangani fase kritis,{' '}
        <span class="box-decoration-clone bg-[#FFD84D]/45 px-1 font-bold text-slate-950">
          batang kurus, tongkol jadi kecil kopong, dan tonase panen anjlok habis!
        </span>
      </p>
    </div>

    <div class="flex flex-col">
      <div class="relative overflow-hidden border-y border-slate-200 bg-slate-100">
        <img
          src="/images/landing/bensu-jagung/hero-petani.webp"
          width="800"
          height="800"
          alt="Petani jagung memeriksa tanaman jagung kuning, kerdil, dan daun menggulung di lahan"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="aspect-square w-full object-cover"
        />
      </div>

      <div class="grid grid-cols-3 divide-x divide-slate-200 border-b border-slate-200 bg-slate-50 text-center">
        <div class="px-2 py-3">
          <p class="text-[11px] font-bold leading-tight text-slate-950">Daun Kuning</p>
          <p class="mt-0.5 text-[10px] leading-tight text-slate-500">Pucat & menggulung</p>
        </div>
        <div class="px-2 py-3">
          <p class="text-[11px] font-bold leading-tight text-slate-950">Batang Kerdil</p>
          <p class="mt-0.5 text-[10px] leading-tight text-slate-500">Tinggi tidak rata</p>
        </div>
        <div class="px-2 py-3">
          <p class="text-[11px] font-bold leading-tight text-slate-950">Tongkol Kopong</p>
          <p class="mt-0.5 text-[10px] leading-tight text-slate-500">Biji jarang & ringan</p>
        </div>
      </div>

      <div class="px-4 pt-4">
        <div class="border border-slate-200 border-l-[3px] border-l-[#0F2A5F] bg-white px-4 py-3">
          <h2 class="text-[14px] font-bold leading-snug text-slate-950">
            Jagung stres tidak akan pulih sendiri meski pupuk dasar ditambah terus.
          </h2>
          <p class="mt-1 text-[13px] leading-snug text-slate-600">
            Begitu akar lumpuh dan daun berhenti tumbuh, wajib{' '}
            <strong class="font-semibold text-[#0F2A5F]">bangunkan paksa lewat serap kilat daun + bongkar akar yang macet</strong>{' '}
            sekarang juga!
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-100 px-5 py-9">
    <h2 class={sectionTitle}>
      BENSU bukan pupuk jagung biasa. Ini <span class="box-decoration-clone bg-[#DBEAFE] px-1.5 pb-0.5 text-[#0F2A5F]"
        >booster brutal pendobrak jagung kerdil</span
      > yang bikin batang kokoh dan tongkol meledak berisi!
    </h2>
    <p class={`${body} mt-3`}>
      Kerjanya langsung tembus pori daun dan membangunkan akar yang mogok — memaksa jagung kuning kembali rakus
      menyerap pupuk dasar sampai tinggi seragam dan siap panen berat.
    </p>
    <div class="mt-6 grid gap-2.5">
      <div class="rounded-md border border-[#0F2A5F]/15 bg-[#EFF6FF]/60 p-3.5">
        <div class="flex gap-3">
          <span class={listIcon}><Icon name="lucide:zap" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Sapu bersih daun kuning & pucat</strong> dengan nutrisi cepat serap yang
            langsung memulihkan hijau daun dan memutus tanaman kerdil.
          </p>
        </div>
      </div>
      <div class="rounded-md border border-slate-200 bg-white p-3.5">
        <div class="flex gap-3">
          <span class={listIcon}><Icon name="lucide:sprout" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Bongkar akar yang lumpuh</strong> akibat tanah asam atau cuaca
            ekstrem supaya akar kembali ganas menyedot urea & NPK di tanah.
          </p>
        </div>
      </div>
      <div class="rounded-md border border-[#0F2A5F]/15 bg-[#EFF6FF]/60 p-3.5">
        <div class="flex gap-3">
          <span class={listIcon}><Icon name="lucide:shield-plus" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Pacu batang gemuk & tongkol penuh sampai ujung</strong> — daun lebih tebal
            dan tegak sehingga jagung tahan panas, hujan deras, dan tidak gampang rebah.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-red-100 bg-[#FEF2F2]/60 px-5 py-9">
    <h2 class="text-[23px] font-bold leading-[1.18] tracking-tight text-[#991B1B]">
      Kalau 4 tanda ini muncul di lahan, jagung Anda sudah <span
        class="underline decoration-red-200 decoration-4 underline-offset-4">mode darurat gagal panen</span
      >
    </h2>
    <div class="mt-6 grid gap-4">
      <div class="flex gap-3">
        <span class={dangerIcon}><Icon name="lucide:triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
        <p class={body}>
          <strong class="text-slate-950">Daun menguning pucat, bergaris, atau menggulung</strong> di umur 2–5 minggu
          padahal pupuk kimia sudah masuk penuh.
        </p>
      </div>
      <div class="flex gap-3">
        <span class={dangerIcon}><Icon name="lucide:triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
        <p class={body}>
          <strong class="text-slate-950">Pertumbuhan belang dan kerdil</strong> — sebagian tinggi, sebagian macet pendek
          dengan batang kurus mudah rebah.
        </p>
      </div>
      <div class="flex gap-3">
        <span class={dangerIcon}><Icon name="lucide:triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
        <p class={body}>
          <strong class="text-slate-950">Stres berat habis hujan deras atau kemarau panas</strong> — ujung daun gosong
          kering dan tunas baru berhenti keluar.
        </p>
      </div>
      <div class="flex gap-3">
        <span class={dangerIcon}><Icon name="lucide:triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
        <p class={body}>
          <strong class="text-slate-950">Bunga keluar terlambat & tongkol kecil kopong</strong> — ujung tongkol banyak
          biji ompong yang langsung menghancurkan bobot panen.
        </p>
      </div>
    </div>
    <p class="mt-5 border-l-[3px] border-[#991B1B] bg-white px-3.5 py-2.5 text-[13.5px] font-medium leading-snug text-slate-800">
      <strong class="text-[#991B1B]">Lewat umur 45 hari sudah terlambat:</strong> sekali jagung telanjur keluar bunga
      dalam kondisi kerdil, tongkol tidak bisa lagi dibesarkan.
    </p>
  </section>

  <section class="border-t border-slate-100 px-5 py-9">
    <h2 class={sectionTitle}>
      Kenapa jagung tetap kuning <span class="box-decoration-clone bg-[#DBEAFE] px-1.5 pb-0.5 text-[#0F2A5F]"
        >meski sudah diguyur urea & NPK mahal?</span
      >
    </h2>
    <p class={`${body} mt-3 mb-5`}>
      Saat tanah asam, lembap berlebih, atau tanaman syok cuaca, <strong class="text-slate-950"
        >akar jagung terkunci tidak mampu menyedot pupuk dasar</strong
      >. Tambah pupuk kimia terus-terusan cuma bikin biaya membengkak. Yang dibutuhkan itu <strong
        class="text-slate-950">stimulator cepat serap lewat daun + pemulih akar aktif</strong
      >.
    </p>
    <div class="grid gap-3.5">
      <figure class="relative overflow-hidden border border-slate-200 bg-white">
        <img
          src="/images/landing/bensu-jagung/kondisi-awal.webp"
          width="840"
          height="560"
          alt="Tanaman jagung kuning, kerdil, dan batang kurus sebelum diberi BENSU"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <figcaption
          class="absolute left-3 top-3 rounded-sm bg-[#991B1B] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-white shadow-sm"
        >
          Akar Terkunci & Kerdil
        </figcaption>
      </figure>
      <figure class="relative overflow-hidden border border-slate-200 bg-white">
        <img
          src="/images/landing/bensu-jagung/akar-nutrisi.webp"
          width="840"
          height="560"
          alt="Pangkal batang jagung kokoh dengan akar kuat dan daun hijau pekat"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <figcaption
          class="absolute left-3 top-3 rounded-sm bg-[#15803D] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-white shadow-sm"
        >
          Akar Aktif & Batang Kokoh
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="border-t border-[#0F2A5F]/20 bg-[#0A1D42] px-5 py-9 text-white">
    <p class="mb-2 text-[11px] font-semibold uppercase tracking-widest text-[#FACC15]">
      Panduan Wajib Lahan Jagung
    </p>
    <h2 class="text-[24px] font-bold leading-[1.16] tracking-tight text-white">
      Cara Pakai Khusus Jagung: <span class="text-[#DBEAFE]">Takaran & Waktu Pemakaian</span>
    </h2>
    <p class="mt-2.5 mb-5 text-[14px] leading-relaxed text-slate-300">
      Ikuti 3 langkah presisi di bawah ini supaya jagung kuning cepat pulih hijau pekat dan batang langsung melesat
      seragam!
    </p>

    <div class="-mx-5 grid gap-3">
      <div class="relative overflow-hidden bg-slate-900">
        <img
          src="/images/landing/bensu-jagung/sebelum-perawatan.webp"
          width="840"
          height="560"
          alt="Hamparan lahan jagung kuning, belang, dan kerdil sebelum perawatan BENSU"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <div
          class="absolute left-3.5 top-3.5 rounded-sm bg-[#991B1B] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow"
        >
          Sebelum
        </div>
      </div>
      <div class="relative overflow-hidden bg-slate-900">
        <img
          src="/images/landing/bensu-jagung/setelah-perawatan.webp"
          width="840"
          height="560"
          alt="Lahan jagung hijau pekat, batang kokoh seragam, dan tongkol besar setelah BENSU"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <div
          class="absolute left-3.5 top-3.5 rounded-sm bg-[#15803D] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow"
        >
          Setelah Perawatan
        </div>
      </div>
    </div>

    <div class="mt-7 space-y-5">
      <!-- Step 1 -->
      <div class="relative flex gap-3.5">
        <div class="flex flex-col items-center">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-[#FACC15] text-[#0A1D42]">
            <Icon name="lucide:droplets" class="h-4.5 w-4.5" aria-hidden="true" />
          </span>
          <span class="mt-2 w-px flex-1 bg-white/15" aria-hidden="true"></span>
        </div>
        <div class="flex-1 pb-2">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[#FACC15]">Langkah 01</p>
          <h3 class="mt-0.5 text-[16px] font-bold text-white">Semprot Daun & Batang</h3>
          <div class="mt-2.5 grid grid-cols-2 gap-2">
            <div class="bg-white/8 px-3 py-2.5">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-300">Fase Awal (14–28 HST)</p>
              <p class="mt-1 text-[17px] font-extrabold leading-none text-[#DBEAFE]">3–4 ml / L</p>
              <p class="mt-1 text-[11px] text-slate-400">45–60 ml / tangki 15L</p>
            </div>
            <div class="bg-white/8 px-3 py-2.5">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-300">Fase Tumbuh (30–50 HST)</p>
              <p class="mt-1 text-[17px] font-extrabold leading-none text-[#DBEAFE]">5 ml / L</p>
              <p class="mt-1 text-[11px] text-slate-400">75 ml / tangki 15L</p>
            </div>
          </div>
          <p class="mt-2 text-[12.5px] text-slate-300">Semprot kabut halus merata ke seluruh daun & batang jagung.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative flex gap-3.5">
        <div class="flex flex-col items-center">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-[#FACC15] text-[#0A1D42]">
            <Icon name="lucide:sprout" class="h-4.5 w-4.5" aria-hidden="true" />
          </span>
          <span class="mt-2 w-px flex-1 bg-white/15" aria-hidden="true"></span>
        </div>
        <div class="flex-1 pb-2">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[#FACC15]">Langkah 02</p>
          <h3 class="mt-0.5 text-[16px] font-bold text-white">Kocor Pangkal Akar (Blok Kerdil)</h3>
          <div class="mt-2.5 bg-[#1E3A8A]/70 px-3 py-2">
            <span class="text-[15px] font-extrabold text-white">5 ml / 1 L air</span>
            <span class="ml-1.5 text-[12px] text-[#DBEAFE]">(100 ml / 20 L air)</span>
          </div>
          <p class="mt-2 text-[12.5px] text-slate-300">
            Kocor <strong class="text-white">150–200 ml per lubang tanam</strong> khusus area jagung yang kuning parah
            atau macet tumbuh.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative flex gap-3.5">
        <div class="flex flex-col items-center">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-[#FACC15] text-[#0A1D42]">
            <Icon name="lucide:calendar-sync" class="h-4.5 w-4.5" aria-hidden="true" />
          </span>
        </div>
        <div class="flex-1">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[#FACC15]">Langkah 03</p>
          <h3 class="mt-0.5 text-[16px] font-bold text-white">Waktu & Jadwal Pakai</h3>
          <div class="mt-2.5 bg-white/10 px-3 py-2 text-[12.5px] text-slate-100">
            <strong class="text-[#FACC15]">Pagi 06.30–09.00</strong> atau <strong class="text-[#FACC15]">Sore 15.30–17.30 WIB</strong>
            <span class="block text-[11px] text-slate-300">Saat pori daun terbuka; hindari terik siang & hujan deras</span>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <div class="bg-[#1E3A8A]/65 px-3 py-2.5">
              <p class="text-[10px] font-bold uppercase tracking-wide text-[#FACC15]">Pemulihan Cepat (Kuning)</p>
              <p class="mt-0.5 text-[15px] font-extrabold text-white">Tiap 5–7 hari</p>
              <p class="mt-0.5 text-[11px] text-slate-200">2–3 putaran sampai hijau</p>
            </div>
            <div class="bg-white/8 px-3 py-2.5">
              <p class="text-[10px] font-bold uppercase tracking-wide text-slate-300">Perawatan Rutin</p>
              <p class="mt-0.5 text-[15px] font-extrabold text-white">Tiap 10–14 hari</p>
              <p class="mt-0.5 text-[11px] text-slate-300">Umur 14, 28 & 42 HST</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-10">
    <h2 class={sectionTitle}>
      Dipakai saat lahan jagung mulai <span class="box-decoration-clone bg-[#DBEAFE] px-1.5 pb-0.5 text-[#0F2A5F]"
        >kuning, belang & terancam gagal panen</span
      >
    </h2>
    <p class={`${body} mt-2.5 mb-8`}>
      Saat jagung kerdil di fase kritis, petani butuh bukti nyata di lapangan — bukan cuma tambah pupuk mahal lalu
      berharap pulih sendiri.
    </p>

    <div class="space-y-9">
      <article>
        <img
          src="/images/landing/bensu-jagung/testi-petani-1.webp"
          width="840"
          height="560"
          alt="Petani jagung memegang dua tongkol jagung besar padat biji sampai ujung"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <div class="mt-3.5 flex items-start justify-between gap-3">
          <div>
            <p class="flex items-center gap-1.5 text-[15px] font-bold text-slate-950">
              Pak Suparman
              <span class="flex h-4 w-4 items-center justify-center text-blue-600"
                ><Icon name="lucide:badge-check" class="h-4 w-4" aria-hidden="true" /></span
              >
            </p>
            <p class="mt-0.5 text-[12px] font-medium text-slate-500">Sragen, Jawa Tengah · Jagung Kuning & Kerdil</p>
          </div>
          <div class="shrink-0 text-[13px] tracking-tight text-[#F59E0B]" role="img" aria-label="5 dari 5 bintang">
            ★★★★★
          </div>
        </div>
        <p class="mt-2.5 text-[14.5px] leading-relaxed text-slate-700">
          “Sempat pasrah lihat jagung umur 3 minggu <strong class="box-decoration-clone bg-[#FFD84D]/45 px-1 text-slate-950"
            >kuning pucat dan kerdil</strong
          > padahal pupuk dasar sudah masuk. Habis semprot BENSU 2 kali, <strong class="text-[#0F2A5F]"
            >daun balik hijau gelap, batang kokoh, dan tongkolnya berisi penuh sampai ujung</strong
          >.”
        </p>
      </article>

      <article>
        <img
          src="/images/landing/bensu-jagung/testi-petani-2.webp"
          width="840"
          height="560"
          alt="Batang jagung kokoh bertongkol besar dan panjang di kebun petani"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <div class="mt-3.5 flex items-start justify-between gap-3">
          <div>
            <p class="flex items-center gap-1.5 text-[15px] font-bold text-slate-950">
              Wahyu M
              <span class="flex h-4 w-4 items-center justify-center text-blue-600"
                ><Icon name="lucide:badge-check" class="h-4 w-4" aria-hidden="true" /></span
              >
            </p>
            <p class="mt-0.5 text-[12px] font-medium text-slate-500">Kediri, Jawa Timur · Daun Menggulung & Belang</p>
          </div>
          <div class="shrink-0 text-[13px] tracking-tight text-[#F59E0B]" role="img" aria-label="5 dari 5 bintang">
            ★★★★★
          </div>
        </div>
        <p class="mt-2.5 text-[14.5px] leading-relaxed text-slate-700">
          “Blok pinggir yang tadinya <strong class="box-decoration-clone bg-[#FFD84D]/45 px-1 text-slate-950"
            >daunnya menggulung dan tinggi tidak rata</strong
          > langsung mengejar setelah dikocor BENSU. <strong class="text-[#0F2A5F]"
            >Batang jadi besar dan banyak yang keluar tongkol dua berisi</strong
          > — pengiriman COD juga cepat.”
        </p>
      </article>

      <article>
        <img
          src="/images/landing/bensu-jagung/testi-petani-3.webp"
          width="840"
          height="560"
          alt="Petani berdiri di tengah kebun jagung tinggi hijau subur setelah BENSU"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
        <div class="mt-3.5 flex items-start justify-between gap-3">
          <div>
            <p class="flex items-center gap-1.5 text-[15px] font-bold text-slate-950">
              H. Anwar
              <span class="flex h-4 w-4 items-center justify-center text-blue-600"
                ><Icon name="lucide:badge-check" class="h-4 w-4" aria-hidden="true" /></span
              >
            </p>
            <p class="mt-0.5 text-[12px] font-medium text-slate-500">Lampung Tengah · Stres Cuaca & Akar Mogok</p>
          </div>
          <div class="shrink-0 text-[13px] tracking-tight text-[#F59E0B]" role="img" aria-label="5 dari 5 bintang">
            ★★★★★
          </div>
        </div>
        <p class="mt-2.5 text-[14.5px] leading-relaxed text-slate-700">
