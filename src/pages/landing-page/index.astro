---
/**
 * Solutions index (install theme: Petani Sejahtera), the page the storefront
 * calls "Solusi Terbaru" — ported from petanisejahtera.com's /solusi-terbaru.
 *
 * The list is the store's *published* landing pages (read-only, as in the
 * product's version: a storefront request never reconciles the register).
 * Each is dressed with its solution card from the published home content —
 * photo, crop and excerpt — when one points at it; a page without a card
 * still lists, with the product's list thumbnail. A card whose page is not published is not
 * shown, so nothing here links to a 404.
 */
import PageIntro from '../../components/storefront/shared/PageIntro.astro';
import Icon from '../../components/storefront/shared/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listPublicLandingPages } from '../../lib/landing-pages';
import { getTenantHomeContent } from '../../lib/tenant-content';
import { cardImageSrc } from '../../lib/image-derivative';

export const prerender = false;

const [pages, home] = await Promise.all([
  listPublicLandingPages(Astro.locals),
  getTenantHomeContent(Astro.locals),
]);
const cards = home.state === 'ready' ? home.content.solutions : [];
const cardFor = (href: string, slug: string) =>
  cards.find((card) => card.href === href || card.href === `/${slug}`);

const items = pages.map((page) => {
  const card = cardFor(page.href, page.slug);
  return {
    href: page.href,
    title: card?.title || page.title,
    excerpt: card?.excerpt || page.excerpt,
    // The home card's photo first; else the list thumbnail the product picks
    // (the page's own image, its register image, or its product's photo).
    image: card?.image || page.image,
    crop: card?.crop || 'Solusi',
  };
});
const cropTone = (crop: string) =>
  /sawit/i.test(crop) ? '#8B1E1E' : /jagung/i.test(crop) ? '#B45309' : '#14532D';
const storeName = Astro.locals.tenant.name;
---

<BaseLayout
  title={`Solusi Terbaru - ${storeName}`}
  description={`Pilih halaman solusi ${storeName} sesuai masalah tanaman: sawit, jagung, padi, anggrek, dan anthurium — lengkap dengan edukasi, bukti lapangan, dan form order.`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Solusi Terbaru', url: '/landing-page' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-white text-[#263238]">
    <PageIntro
      badge="Solusi Lapangan"
      title="Pilih Solusi Sesuai Masalah Tanaman"
      description="Setiap halaman membahas satu masalah lapangan secara spesifik: gejala, edukasi, bukti visual, dan form order yang fokus."
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Solusi Terbaru' }]}
    />

    <section aria-label="Daftar solusi" class="mx-auto max-w-[480px] px-5 py-8">
      {items.length > 0 ? (
        <div class="divide-y divide-[#E5E7EB]">
          {items.map((item, index) => (
            <article>
              <a href={item.href} class:list={['group block py-5', index === 0 && 'pt-0']}>
                {item.image && (
                  <div class="relative aspect-[3/2] overflow-hidden rounded-[14px] bg-slate-100">
                    <img
                      src={cardImageSrc(item.image)}
                      alt={`Solusi ${item.title}`}
                      width="600"
                      height="400"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      fetchpriority={index === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent p-3">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex rounded-md bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em]" style={`color: ${cropTone(item.crop)}`}>
                          {item.crop}
                        </span>
                        <span class="inline-flex rounded-md bg-[#D9F99D] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#1B5E20]">Live</span>
                      </div>
                    </div>
                  </div>
                )}
                <div class:list={[item.image && 'pt-3']}>
                  <h2 class:list={['font-semibold leading-[1.28] tracking-[-0.02em] text-[#263238]', index === 0 ? 'text-[21px]' : 'text-[19px]']}>
                    {item.title}
                  </h2>
                  {item.excerpt && <p class="mt-2 text-[13px] leading-6 text-[#616161]">{item.excerpt}</p>}
                  <span class="mt-2.5 inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#1B5E20]">
                    Lihat detail solusi
                    <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-[#E5E7EB] py-10 text-center">
          <h2 class="text-lg font-semibold text-[#263238]">Belum ada halaman solusi</h2>
          <p class="mt-2 text-sm leading-6 text-[#616161]">Halaman solusi akan muncul di sini setelah diterbitkan.</p>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
