---
import { geoHeadersFromCf } from '../../lib/geo';
import Breadcrumb from '../../components/storefront/shared/Breadcrumb.astro';
import MetaLandingTracker from '../../components/storefront/tracking/MetaLandingTracker.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStorefrontProduct } from '../../lib/catalog';
import { getProductPageLanding } from '../../lib/landing-pages';
import Icon from '../../components/storefront/shared/Icon.astro';
import RatingStars from '../../components/storefront/shared/RatingStars.astro';
import GeoIpResolvedForm from '../../components/storefront/forms/GeoIpResolvedForm.astro';
import ProductImageGallery from '../../components/storefront/ProductImageGallery.astro';
import SocialProofToast from '../../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../../lib/social-proof';
import { getRuntimeEnv } from '../../lib/env';
import { resolveFormModeContext } from '../../lib/form-mode';
import '../../styles/form-hybrid.css';
import { defaultCatalogContentId } from '../../lib/catalog-feed';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, Astro.params.slug || '');
const formContext = await resolveFormModeContext(Astro.request);
if (!product) {
  return Astro.rewrite('/404');
}

// A landing page may have taken this product's page over (A21). The landing
// route owns the whole rendering path already, so this hands off to it rather
// than growing a second copy here. The URL stays `/produk/<slug>`: that is the
// product's address, and the landing page's own slug redirects to it, so the
// two never compete as duplicate content.
// `astro check` does not count a value used only in a frontmatter `return` as
// read, so the geo helper is named once here to keep that check clean.
void geoHeadersFromCf;

const productPageLanding = await getProductPageLanding(
  Astro.locals,
  String(product.productId),
);
if (productPageLanding) {
  // The rewritten route does NOT see this route's `Astro.url` — it sees the
  // landing slug — so the hand-off is signalled on the request itself.
  // Without it the landing route reads a direct visit, redirects back here,
  // and the two bounce forever.
  return Astro.rewrite(
    new Request(new URL(`/${productPageLanding.slug}`, Astro.url), {
      headers: new Headers({
        ...Object.fromEntries(Astro.request.headers),
        // The rebuilt request loses `request.cf`; without the visitor's
        // province the landing's hybrid form showed everyone the full form.
        ...geoHeadersFromCf(Astro.request),
        'x-adsbook-product-page': product.slug,
      }),
    }),
  );
}
// The store's real orders (A-300); under the threshold the toast renders nothing.
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);

const cheapestVariant = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const displayPrice = cheapestVariant?.price ?? product.price;
const displayComparePrice = cheapestVariant?.comparePrice ?? product.comparePrice ?? 0;
const displayDiscount =
  displayComparePrice > displayPrice ? Math.round((1 - displayPrice / displayComparePrice) * 100) : 0;

const ratingValue = product.ratingValue;
const reviewCount = product.reviewCount;
const soldCount = product.soldCount;
const hasAggregateRating =
  typeof ratingValue === 'number' && typeof reviewCount === 'number' && reviewCount > 0;
const hasSoldCount = typeof soldCount === 'number' && soldCount > 0;
const formattedRating = hasAggregateRating ? ratingValue.toFixed(1) : null;
const soldLabel = hasSoldCount
  ? soldCount >= 1000
    ? `${(soldCount / 1000).toFixed(1).replace('.0', '')}rb+ terjual`
    : `${soldCount} terjual`
  : null;

const productImages = product.images && product.images.length > 0 ? product.images : [product.heroImage];

// Install theme (Petani Sejahtera): each product page wears its label colour.
const productAccentMap: Record<string, string> = {
  bensu: '#0F2A5F',
  aussie: '#8B1E1E',
  kojien: '#4C1D95',
  saratoga: '#14532D',
};
const productAccent = productAccentMap[product.slug] ?? '#1B5E20';
const canonical = `${Astro.locals.tenant.siteUrl}/produk/${product.slug}`;
const productTitle = product.seoTitle;
const productDescription = product.seoDescription;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.productName,
  image: [new URL(product.heroImage, Astro.locals.tenant.siteUrl).toString()],
  description: product.description,
  sku: product.productId,
  brand: {
    '@type': 'Brand',
    name: product.brand || Astro.locals.tenant.name,
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'IDR',
    lowPrice: String(displayPrice),
    highPrice: String(Math.max(...product.variants.map((v) => v.price), displayPrice)),
    offerCount: String(product.variants.length),
    offers: product.variants.map((v) => ({
      '@type': 'Offer',
      price: String(v.price),
      priceCurrency: 'IDR',
      availability: 'https://schema.org/InStock',
      url: canonical,
    })),
  },
  ...(hasAggregateRating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: formattedRating,
          reviewCount: String(reviewCount),
        },
      }
    : {}),
  ...(product.reviews.length > 0
    ? {
        review: product.reviews.map((review) => ({
          '@type': 'Review',
          author: {
            '@type': 'Person',
            name: review.name,
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: String(review.rating),
            bestRating: '5',
          },
          reviewBody: review.comment,
        })),
      }
    : {}),
};

const productSchemaJson = JSON.stringify(productSchema).replace(/</g, '\\u003c');
---

<BaseLayout
  title={productTitle}
  description={productDescription}
  image={product.heroImage}
  preloadImages={product.heroImage}
  canonical={canonical}
  hideHeader={false}
  hideFooter={false}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
    { name: product.productName, url: canonical },
  ]}
>
  <MetaLandingTracker
    slug={product.slug}
    contentId={defaultCatalogContentId(product)}
    contentName={product.productName}
    price={displayPrice}
  />
  {/* The page's only Product JSON-LD: BaseLayout is deliberately given no
      `product`, which would emit a second, conflicting Product block. */}
  <script is:inline type="application/ld+json" set:html={productSchemaJson} />

  {/* Install theme (Petani Sejahtera): the body below is petanisejahtera.com's
      product page — white panels on a light ground, the product's own accent.
      Its fixed "Sisa promo 11 botol" stock line and "Paling laris" badge are
      not carried: neither came from data (ADR-023; AGENTS.md §3). */}
  <main class="mx-auto max-w-[480px] bg-[#FAFAFA] pb-20 text-[#263238]">
    <Breadcrumb
      items={[
        { label: 'Beranda', href: '/' },
        { label: 'Produk', href: '/produk' },
        { label: product.productName },
      ]}
    />
    <section class="bg-white">
      <ProductImageGallery images={productImages} productName={product.productName} />

      <div class="px-5 py-5">
        <div class="flex flex-wrap items-end gap-x-2.5 gap-y-1.5">
          <span class="ps-display text-[30px] font-bold leading-none tracking-[-0.03em]" style={`color: ${productAccent}`}>
            Rp{Math.round(displayPrice).toLocaleString('id-ID')}
          </span>
          {displayComparePrice > displayPrice && (
            <span class="pb-[2px] text-[15px] leading-none text-slate-400 line-through decoration-1">
              Rp{Math.round(displayComparePrice).toLocaleString('id-ID')}
            </span>
          )}
          {displayDiscount > 0 && (
            <span class="mb-[1px] inline-flex items-center rounded-md bg-[#F3F4F6] px-2 py-1 text-[11px] font-semibold leading-none" style={`color: ${productAccent}`}>
              Hemat {displayDiscount}%
            </span>
          )}
        </div>

        <span class="mt-3 inline-flex rounded-md px-2 py-1 text-[10px] font-semibold uppercase leading-none tracking-[0.08em] text-white" style={`background-color: ${productAccent}`}>
            Pilihan unggul
          </span>

        <h1 class="mt-2 text-[19px] font-bold leading-[1.3] tracking-[-0.02em] text-[#263238]">
          <span class="block">{product.productName}</span>
          {product.headline && product.headline !== product.productName && (
            <span class="mt-1 block text-[16px] font-semibold leading-[1.45] tracking-[-0.01em] text-[#616161]">{product.headline}</span>
          )}
        </h1>
        <p class="mt-2 text-[14px] leading-[1.65] text-[#616161]">{product.subheadline || product.description}</p>

        {(hasAggregateRating || hasSoldCount) && (
          <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-[#E5E7EB] pt-4 text-[13px] text-[#616161]">
            {hasAggregateRating && (
              <>
                <div class="flex items-center gap-1.5">
                  <RatingStars rating={ratingValue} starClass="h-[13px] w-[13px]" label={`Rating produk ${formattedRating} dari 5 bintang`} />
                  <span class="font-semibold" style={`color: ${productAccent}`}>{formattedRating}</span>
                </div>
                <span class="h-3 w-px bg-slate-200" aria-hidden="true" />
                <span>{reviewCount} penilaian</span>
              </>
            )}
            {hasAggregateRating && hasSoldCount && <span class="h-3 w-px bg-slate-200" aria-hidden="true" />}
            {hasSoldCount && <span>{soldLabel}</span>}
          </div>
        )}
      </div>
    </section>

    <section class="mt-2 bg-white px-5 py-4">
      <div class="flex items-start gap-3">
        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#F3F4F6]" style={`color: ${productAccent}`}>
          <Icon name="lucide:truck" class="h-[18px] w-[18px]" />
        </div>
        <div>
          <p class="text-[14px] font-semibold text-[#263238]">Informasi Pengiriman</p>
          <p class="mt-1 text-[12px] leading-5 text-[#616161]">Biaya pengiriman dihitung otomatis di halaman checkout setelah alamat pengiriman dilengkapi.</p>
        </div>
      </div>
    </section>

    <section class="mt-2 bg-white px-5 py-5">
      <div class="flex items-center justify-between border-b border-[#E5E7EB] pb-3">
        <h2 class="text-[15px] font-semibold text-[#263238]">Varian & Harga</h2>
        <span class="text-[12px] font-semibold" style={`color: ${productAccent}`}>{product.variants.length} varian</span>
      </div>
      <div class="divide-y divide-slate-100">
        {product.variants.map((v) => {
          const saving = v.comparePrice && v.comparePrice > v.price ? Math.round((1 - v.price / v.comparePrice) * 100) : 0;
          return (
            <div class="flex items-start justify-between gap-4 py-4">
              <div class="flex min-w-0 flex-1 items-start gap-2">
                <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#F3F4F6]" style={`color: ${productAccent}`}>
                  <Icon name="lucide:check" class="h-[11px] w-[11px]" />
                </div>
                <div class="min-w-0">
                  <p class="text-[14px] font-semibold leading-5 text-[#263238]">{product.productName} - {v.label}</p>
                  {saving > 0 && (
                    <span class="mt-2 inline-flex rounded-md bg-[#FAFAFA] px-2 py-1 text-[10px] font-semibold uppercase leading-none tracking-wide" style={`color: ${productAccent}`}>
                      Lebih hemat {saving}%
                    </span>
                  )}
                </div>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-[16px] font-bold leading-none" style={`color: ${productAccent}`}>Rp{Math.round(v.price).toLocaleString('id-ID')}</p>
                {v.comparePrice && v.comparePrice > v.price && (
                  <p class="mt-1 text-[12px] leading-none text-slate-400 line-through">Rp{Math.round(v.comparePrice).toLocaleString('id-ID')}</p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="mt-2 bg-white px-5 py-5">
      <h2 class="border-b border-[#E5E7EB] pb-3 text-[15px] font-semibold text-[#263238]">Informasi Produk</h2>
      <div class="mt-4 grid gap-5 text-[14px] leading-6 text-[#616161]">
        <p>{product.description}</p>

        <div class="grid gap-3 border-b border-[#E5E7EB] pb-4">
          <div class="flex items-start gap-3">
            <Icon name="lucide:pencil" class="mt-0.5 h-[18px] w-[18px] shrink-0" style={`color: ${productAccent}`} />
            <div><p class="font-semibold text-[#263238]">Kategori</p><p>{product.category}</p></div>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="lucide:package" class="mt-0.5 h-[18px] w-[18px] shrink-0" style={`color: ${productAccent}`} />
            <div><p class="font-semibold text-[#263238]">Fokus Produk</p><p>{product.tag}</p></div>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="lucide:sliders-horizontal" class="mt-0.5 h-[18px] w-[18px] shrink-0" style={`color: ${productAccent}`} />
            <div><p class="font-semibold text-[#263238]">Ketersediaan</p><p>Seluruh varian yang ditampilkan tersedia untuk dipesan.</p></div>
          </div>
        </div>

        {product.benefits.length > 0 && (
          <div class="grid gap-4 border-b border-[#E5E7EB] pb-4">
            <div class="flex items-center gap-2">
              <Icon name="lucide:check" class="h-[17px] w-[17px]" style={`color: ${productAccent}`} />
              <h3 class="text-[14px] font-semibold text-[#263238]">Manfaat Utama</h3>
            </div>
            <div class="space-y-3">
              {product.benefits.map((b) => (
                <div class="grid grid-cols-[6px_1fr] gap-3">
                  <span class="mt-[9px] h-1.5 w-1.5 rounded-full" style={`background-color: ${productAccent}`} aria-hidden="true" />
                  <span class="min-w-0 leading-6">{b}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {product.keyPoints.length > 0 && (
          <div class="grid gap-4 border-b border-[#E5E7EB] pb-4">
            <div class="flex items-center gap-2">
              <Icon name="lucide:plus" class="h-[17px] w-[17px]" style={`color: ${productAccent}`} />
              <h3 class="text-[14px] font-semibold text-[#263238]">Poin Penting Produk</h3>
            </div>
            <div class="space-y-3">
              {product.keyPoints.map((point) => (
                <div class="grid grid-cols-[6px_1fr] gap-3">
                  <span class="mt-[9px] h-1.5 w-1.5 rounded-full" style={`background-color: ${productAccent}`} aria-hidden="true" />
                  <span class="min-w-0 leading-6">{point}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {product.idealFor.length > 0 && (
          <div>
            <div class="mb-3 flex items-center gap-2">
              <Icon name="lucide:download" class="h-[17px] w-[17px]" style={`color: ${productAccent}`} />
              <h3 class="text-[14px] font-semibold text-[#263238]">Ideal Untuk</h3>
            </div>
            <div class="flex flex-wrap gap-x-3 gap-y-2">
              {product.idealFor.map((item) => (
                <span class="inline-flex items-center gap-1.5 text-[12px] text-[#616161]">
                  <span class="h-1.5 w-1.5 rounded-full" style={`background-color: ${productAccent}`} aria-hidden="true" />
                  <span>{item}</span>
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    {(hasAggregateRating || product.reviews.length > 0) && (
      <section class="mt-2 bg-white px-5 py-5">
        <div class="border-b border-[#E5E7EB] pb-3">
          <div class="flex items-center gap-2">
            <RatingStars max={1} starClass="h-[17px] w-[17px]" label="Penilaian produk" />
            <h2 class="text-[15px] font-semibold text-[#263238]">Penilaian Produk</h2>
          </div>
          {hasAggregateRating && (
            <div class="mt-1 text-[13px] text-[#616161]">Skor {formattedRating}/5 dari {reviewCount} penilaian pelanggan</div>
          )}
        </div>
        <div class="mt-4 space-y-5">
          {product.reviews.map((review) => (
            <div class="border-b border-[#E5E7EB] pb-4 last:border-0 last:pb-0">
              <div class="flex items-center gap-2.5">
                <img src={review.avatar} alt={`Foto ${review.name}`} class="h-10 w-10 shrink-0 rounded-full object-cover" width="40" height="40" loading="lazy" decoding="async" />
                <div class="min-w-0">
                  <div class="flex items-center gap-1">
                    <p class="text-[12px] font-semibold text-slate-700">{review.name}</p>
                    {review.verified && (
                      <svg viewBox="0 0 22 22" class="h-3.5 w-3.5 shrink-0" role="img" aria-label="Pembeli terverifikasi">
                        <path fill="#1D9BF0" d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.689.878.634.132 1.293.082 1.901-.14.272.587.702 1.087 1.242 1.443s1.17.555 1.816.573c.647-.018 1.276-.216 1.817-.572s.973-.856 1.245-1.443c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z" />
                      </svg>
                    )}
                  </div>
                  <p class="text-[11px] text-slate-400">{review.location} • {review.date}</p>
                </div>
              </div>
              <RatingStars rating={review.rating} class="mt-2" starClass="h-2.5 w-2.5" />
              <p class="mt-2 text-[13px] leading-6 text-slate-600">{review.comment}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mt-2 bg-white px-5 py-4">
      <div class="flex items-start gap-3 text-[12px] leading-5 text-[#616161]">
        <Icon name="lucide:info" class="mt-0.5 h-4 w-4 shrink-0" style={`color: ${productAccent}`} />
        <p>Silakan isi form di bawah untuk langsung memesan varian yang Anda pilih.</p>
      </div>
    </section>

    <!-- Direct Order Form Container -->
    <section id="form-pemesanan" class="mt-2 scroll-mt-6 overflow-hidden bg-white p-2">
      <GeoIpResolvedForm mode={formContext.mode} province={formContext.province} productSlug={product.slug} embedded={true} />
    </section>

    <SocialProofToast
      orderCount={socialProofOrders}
    />

    <!-- Sticky Mobile Purchase Bar (Auto-hides while the hero or the order
         form is visible: over the hero it covers the product photo before the
         visitor has read anything, and over the form its CTA points at a form
         already on screen) -->
    <div id="sticky-purchase-bar" class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between border-fade-t bg-white/95 px-5 py-3 shadow-[0_-8px_24px_rgba(17,17,17,0.08)] backdrop-blur-md transition-all duration-300 lg:hidden" style="transform: translateY(100%); opacity: 0; pointer-events: none;">
      <div>
        <p class="text-[9px] font-semibold uppercase tracking-[0.12em] text-[#555555]">Harga Promo</p>
        <p class="text-base font-bold" style={`color: ${productAccent}`}>Rp{Math.round(displayPrice).toLocaleString('id-ID')}</p>
      </div>
      <a
        href="#form-pemesanan"
        class="inline-flex min-h-11 items-center justify-center rounded-full border border-[#1B5E20] bg-[#1B5E20] px-6 text-[11px] font-semibold uppercase tracking-[0.1em] text-white transition-colors hover:bg-[#134417] hover:border-[#134417] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B5E20] active:scale-[0.98]"
      >
        Pesan Sekarang
      </a>
    </div>
  </main>

  <script>
    function initStickyBarObserver() {
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const orderForm = document.getElementById('form-pemesanan');
      const hero = document.querySelector('[data-gallery]');
      if (!stickyBar || !orderForm) return;

      // The bar hides while EITHER blocker is on screen. It also starts hidden
      // in the markup, because the hero fills the first viewport — waiting for
      // the observer's first callback used to flash the bar over the photo.
      let heroVisible = true;
      let formVisible = false;

      const applyStickyVisibility = () => {
        if (heroVisible || formVisible) {
          stickyBar.style.transform = 'translateY(100%)';
          stickyBar.style.opacity = '0';
          stickyBar.style.pointerEvents = 'none';
        } else {
          stickyBar.style.transform = 'translateY(0)';
          stickyBar.style.opacity = '1';
          stickyBar.style.pointerEvents = 'auto';
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === hero) heroVisible = entry.isIntersecting;
            if (entry.target === orderForm) formVisible = entry.isIntersecting;
          });
          applyStickyVisibility();
        },
        { threshold: 0, rootMargin: '0px 0px -40px 0px' }
      );

      if (hero) observer.observe(hero);
      else heroVisible = false;
      observer.observe(orderForm);
      applyStickyVisibility();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBarObserver);
    } else {
      initStickyBarObserver();
    }
  </script>
</BaseLayout>
