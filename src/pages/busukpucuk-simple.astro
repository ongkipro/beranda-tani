>
  <main class="ps-page">
    <MetaLandingTracker slug={SLUG} contentId={defaultCatalogContentId(product)} contentName={product.productName} price={product.price} />
    <section class="ps-text ps-large" style="padding-top:25px;padding-bottom:25px">
      <div>
        <h1 class="ps-h1">Atasi <span style="color:#B71C1C">Busuk Pucuk</span> pada Kelapa Sawit Anda dengan <strong>Aussie</strong></h1>
        <p>Jangan biarkan busuk pucuk merusak panen dan masa depan kelapa sawit Anda.</p>
      </div>
    </section>
    <div class="ps-image"><img src="/images/landing/busukpucuk-simple/01.webp" width="720" height="1000" alt="Atasi Busuk Pucuk Kelapa Sawit dengan Aussie — gambar 1" fetchpriority="high" /></div>
