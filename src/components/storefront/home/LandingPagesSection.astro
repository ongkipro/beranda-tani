---
/**
 * Petani Sejahtera solution cards (install theme), ported from
 * petanisejahtera.com's SolutionsSection: a 3:2 photo with the product's dot
 * and name, the crop and running number, title, excerpt and "Buka halaman".
 * The first four show; the rest are one tap away on /landing-page.
 */
import Icon from '../shared/Icon.astro';

interface LandingPage {
  title: string;
  excerpt: string;
  image?: string;
  href?: string;
  crop?: string;
}
interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}
interface Props {
  pages: LandingPage[];
  heading: Heading;
  limit?: number;
}

const { pages, heading, limit = 4 } = Astro.props;
// Only the ones that go somewhere: a card the visitor cannot open is worse
// than not listing it.
const linked = pages.filter((page) => Boolean(page.href));
const visible = linked.slice(0, limit);

const productDots: Record<string, string> = {
  bensu: 'bg-[#0F2A5F]',
  aussie: 'bg-[#8B1E1E]',
  kojien: 'bg-[#4C1D95]',
  saratoga: 'bg-[#14532D]',
};
const productOf = (href = '') => href.replace(/^\//, '').split('-')[0] ?? '';
---

{
  linked.length > 0 && (
    <section id="solusi" class="bg-[#FAFAFA] px-5 py-10">
      <div class="mb-5">
        <span class="inline-flex rounded-full bg-[#EDF6EA] px-3 py-1 text-[11px] font-semibold text-[#1B5E20]">{heading.eyebrow}</span>
        <h2 class="ps-display mt-3 text-[24px] font-extrabold tracking-[-0.02em] text-[#263238]">{heading.title}</h2>
        <p class="mt-2 text-[14px] leading-6 text-[#616161]">{heading.description}</p>
      </div>

      <div class="divide-y divide-[#E5E7EB]">
        {visible.map((page, index) => {
          const product = productOf(page.href);
          const label = page.crop || 'Solusi';
          return (
            <a href={page.href} class="group block py-5 first:pt-0 last:pb-0">
              <article>
                {page.image && (
                  <div class="relative aspect-[3/2] overflow-hidden rounded-t-[16px] bg-zinc-100">
                    <img
                      src={page.image}
                      alt={`Solusi ${page.title}`}
                      width="600"
                      height="400"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/45 to-transparent p-3">
                      <span class="inline-flex items-center gap-1.5 rounded-md bg-white/92 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-[#1B5E20] backdrop-blur-sm">
                        <span class={`h-1.5 w-1.5 rounded-full ${productDots[product] ?? 'bg-[#F9A825]'}`} aria-hidden="true" />
                        <span>{label}</span>
                      </span>
                    </div>
                  </div>
                )}
                <div class="px-1 pt-3">
                  <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.1em] text-[#2E7D32]">
                    <span>{label}</span>
                    <span class="h-1 w-1 rounded-full bg-[#F9A825]" aria-hidden="true" />
                    <span>Solusi #{String(index + 1).padStart(2, '0')}</span>
                  </div>
                  <h3 class="mt-1.5 text-[17px] font-semibold leading-6 text-[#263238]">{page.title}</h3>
                  <p class="mt-1.5 text-[13px] leading-6 text-[#616161]">{page.excerpt}</p>
                  <span class="mt-2.5 inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#1B5E20]">
                    Buka halaman
                    <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
                  </span>
                </div>
              </article>
            </a>
          );
        })}
      </div>

      {linked.length > visible.length && (
        <a
          href="/landing-page"
          class="mt-5 flex min-h-11 items-center justify-center gap-2 rounded-[14px] border border-[#D7E7D8] bg-white px-4 py-3 text-[13px] font-semibold text-[#1B5E20] transition-colors hover:bg-[#F4FAF2]"
        >
          Muat solusi lainnya
          <Icon name="lucide:chevron-down" class="h-4 w-4" />
        </a>
      )}
    </section>
  )
}
