---
/**
 * Petani Sejahtera product grid (install theme), ported from
 * petanisejahtera.com: photo with its sizes as glass chips, the product's
 * positioning line in green, name, a short description and a link. Price
 * lives on the product page, as in the source. The product's search and
 * load-more are left out: the source has neither and this catalogue is small.
 */
import Icon from '../shared/Icon.astro';
import { cardImageSrc } from '../../../lib/image-derivative';

interface Product {
  slug: string;
  name: string;
  category: string;
  tag?: string;
  description: string;
  href: string;
  image: string;
  variants?: Array<{ label: string; price: number }>;
}
interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}
interface Props {
  products: Product[];
  heading: Heading;
}

const { products, heading } = Astro.props;
---

<section id="produk" class="border-y border-[#E5E7EB] bg-[#FAFAFA] px-5 py-10">
  <div class="mb-5">
    <span class="inline-flex rounded-md border border-[#D7E7D8] bg-[#EDF6EA] px-3 py-1 text-[11px] font-semibold text-[#1B5E20]">{heading.eyebrow}</span>
    <h2 class="ps-display mt-3 text-[24px] font-extrabold tracking-[-0.02em] text-[#263238]">{heading.title}</h2>
    <p class="mt-1 text-[14px] leading-6 text-[#616161]">{heading.description}</p>
  </div>

  {
    products.length === 0 ? (
      <div class="rounded-xl border border-[#E5E7EB] bg-white px-5 py-10 text-center">
        <p class="text-[13px] font-semibold text-[#263238]">Katalog sedang disiapkan</p>
        <p class="mx-auto mt-2 max-w-[26rem] text-[12px] leading-6 text-[#616161]">
          Produk akan muncul di sini setelah ditambahkan dan varian harganya diisi dari dashboard.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-2 gap-x-4 gap-y-6">
        {products.map((product) => (
          <article class="flex flex-col">
            <a href={product.href} class="block" aria-label={`Lihat produk ${product.name}`}>
              <div class="relative aspect-square overflow-hidden rounded-[10px] border border-[#E5E7EB] bg-white">
                <img src={cardImageSrc(product.image)} alt={`Foto produk ${product.name}`} width="300" height="300" class="h-full w-full object-cover" loading="lazy" decoding="async" />
                <div class="pointer-events-none absolute left-2 top-2 flex flex-wrap gap-1.5">
                  {(product.variants ?? []).map((variant) => (
                    <span class="inline-flex rounded-md bg-white/40 px-2 py-1 text-[10px] font-semibold leading-none text-[#263238] shadow-[0_8px_20px_rgba(15,23,42,0.16)] backdrop-blur-md">
                      {variant.label}
                    </span>
                  ))}
                </div>
              </div>
            </a>
            <div class="pt-3">
              <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#2E7D32]">{product.tag || product.category}</p>
              <h3 class="mt-1 text-[15px] font-semibold uppercase leading-tight text-[#263238]">{product.name}</h3>
              <p class="mt-2 text-[11px] leading-5 text-[#616161]">{product.description}</p>
              <a href={product.href} class="mt-3 inline-flex min-h-6 items-center gap-1.5 text-[11px] font-semibold text-[#1B5E20]">
                <span>Lihat Produk</span>
                <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          </article>
        ))}
      </div>
    )
  }
</section>
