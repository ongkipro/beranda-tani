---
/**
 * A list of icon + title + sentence rows. Icons are passed as literal
 * `lucide:<name>` strings by the page so `generate-lucide-subset.mjs` can see
 * them; building a name at runtime would render the fallback icon.
 */
import Icon from '../shared/Icon.astro';

interface Item {
  icon: string;
  title: string;
  text: string;
}
interface Props {
  items: Item[];
  /** `2` is a compact grid for short sentences; `1` is the default list. */
  columns?: 1 | 2;
}

const { items, columns = 1 } = Astro.props;
---

<ul class={`lk-features lk-features--${columns}`}>
  {
    items.map((item) => (
      <li class="lk-feature">
        <span class="lk-feature-icon">
          <Icon name={item.icon} class="lk-icon" />
        </span>
        <div>
          <h3 class="lk-feature-title">{item.title}</h3>
          <p class="lk-feature-text">{item.text}</p>
        </div>
      </li>
    ))
  }
</ul>
