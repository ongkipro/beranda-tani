---
/**
 * Petani Sejahtera header (install theme), ported from petanisejahtera.com:
 * wordmark left, a round menu button right that opens a side drawer of the
 * store's key pages. The source's Artikel entry is left out — this store does
 * not carry the article section.
 *
 * The ids carry a `ps-` prefix because BaseLayout still ships an inline drawer
 * script bound to `#menu-toggle`/`#mobile-menu`; two scripts on one drawer
 * raced, and the other one's close skipped this one's focus return.
 */
import Icon from './Icon.astro';
import SiteBrand from './SiteBrand.astro';

const links = [
  { label: 'Semua Produk', href: '/produk', description: 'Lihat semua produk utama yang tersedia.', icon: 'lucide:package' },
  { label: 'Solusi Terbaru', href: '/landing-page', description: 'Buka list solusi dan landing page terbaru.', icon: 'lucide:sprout' },
  { label: 'Ulasan Petani', href: '/testimoni', description: 'Baca ulasan petani dan lihat foto lapangan.', icon: 'lucide:users' },
  { label: 'Tentang Kami', href: '/tentang', description: `Kenali profil ${Astro.locals.tenant.name} lebih dekat.`, icon: 'lucide:circle-user-round' },
  { label: 'Kontak', href: '/kontak', description: 'Hubungi admin untuk pertanyaan dan pesanan.', icon: 'lucide:message-circle' },
];
---

<header class="relative z-40 border-b border-[#E5E7EB]/80 bg-white/90 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-[480px] items-center justify-between px-5">
    <SiteBrand href="/" />
    <button
      id="ps-menu-toggle"
      type="button"
      class="group inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#D7E7D8] bg-[#F4FAF2] text-[#1B5E20] shadow-[0_8px_18px_rgba(36,94,40,0.08)] transition-[background-color,border-color,box-shadow,transform] duration-200 hover:border-[#1B5E20]/30 hover:bg-[#EDF6EA] active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B5E20]"
      aria-expanded="false"
      aria-controls="ps-mobile-menu"
      aria-label="Buka menu"
    >
      <span class="flex w-5 flex-col items-end gap-1.5" aria-hidden="true">
        <span class="h-0.5 w-5 rounded-full bg-current transition-transform duration-200 group-hover:translate-x-0.5"></span>
        <span class="h-0.5 w-4 rounded-full bg-current transition-[width] duration-200 group-hover:w-5"></span>
        <span class="h-0.5 w-5 rounded-full bg-current transition-transform duration-200 group-hover:-translate-x-0.5"></span>
      </span>
    </button>
  </div>
</header>

<div id="ps-menu-backdrop" class="pointer-events-none fixed inset-0 z-40 bg-slate-950/30 opacity-0 transition-opacity duration-200"></div>
<nav
  id="ps-mobile-menu"
  class="invisible fixed right-0 top-0 z-50 flex h-[100dvh] w-[84%] max-w-[336px] translate-x-full flex-col border-l border-[#E5E7EB] bg-white transition-transform duration-200 ease-out"
  aria-label="Menu utama"
  aria-hidden="true"
>
  <div class="border-b border-[#E5E7EB] px-5 pb-4 pt-5">
    <div class="flex items-start justify-between gap-4">
      <SiteBrand href="/" />
      <button
        id="ps-menu-close"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#1B5E20] text-white shadow-[0_8px_18px_rgba(36,94,40,0.22)] transition-[background-color,border-color,box-shadow,transform] duration-200 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B5E20]"
        aria-label="Tutup menu"
      >
        <Icon name="lucide:x" class="h-[18px] w-[18px]" />
      </button>
    </div>
  </div>
  <div class="overflow-y-auto px-5 py-5">
    {
      links.map((link) => (
        <a href={link.href} class="block py-3 transition-colors hover:text-[#1B5E20]">
          <div class="flex items-start justify-between gap-3 border-b border-[#EEF2EA] pb-3">
            <div class="min-w-0">
              <div class="flex items-center gap-3">
                <Icon name={link.icon} class="h-4 w-4 flex-shrink-0 text-[#1B5E20]" />
                <span class="text-[16px] font-semibold leading-5 text-[#263238]">{link.label}</span>
              </div>
              <p class="mt-1 pl-7 text-[12px] leading-5 text-[#616161]">{link.description}</p>
            </div>
            <span class="pt-0.5 text-[#1B5E20]" aria-hidden="true">›</span>
          </div>
        </a>
      ))
    }
  </div>
  <div class="mt-auto border-t border-[#E5E7EB] px-5 py-4">
    <p class="text-[11px] leading-5 text-[#616161]">Gunakan menu ini untuk membuka halaman penting lebih cepat.</p>
  </div>
</nav>

<script>
  const menu = document.getElementById('ps-mobile-menu');
  const backdrop = document.getElementById('ps-menu-backdrop');
  const toggle = document.getElementById('ps-menu-toggle');
  const close = document.getElementById('ps-menu-close');

  const openMenu = () => {
    if (!menu) return;
    menu.classList.remove('invisible');
    // Visible now, so focusable: move focus in at once (and again after the
    // slide starts, in case layout had not caught up).
    close?.focus({ preventScroll: true });
    requestAnimationFrame(() => {
      menu.classList.remove('translate-x-full');
      close?.focus();
    });
    backdrop?.classList.remove('pointer-events-none', 'opacity-0');
    toggle?.setAttribute('aria-expanded', 'true');
    menu.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    if (!menu || menu.classList.contains('translate-x-full')) return;
    menu.classList.add('translate-x-full');
    backdrop?.classList.add('pointer-events-none', 'opacity-0');
    toggle?.setAttribute('aria-expanded', 'false');
    menu.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    toggle?.focus();
    setTimeout(() => {
      if (menu.classList.contains('translate-x-full')) menu.classList.add('invisible');
    }, 200);
  };

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (!menu || menu.classList.contains('translate-x-full')) return;
    if (event.key === 'Escape') {
      closeMenu();
      return;
    }
    // Keep Tab inside the open drawer.
    if (event.key === 'Tab') {
      const focusable = [...menu.querySelectorAll<HTMLElement>('a[href], button')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
</script>
