---
/**
 * Petani Sejahtera footer (install theme), ported from petanisejahtera.com.
 *
 * The product column lists the live catalogue and the WhatsApp line reads the
 * store row, so neither drifts from what the admin holds. Email and office
 * address are this store's published contact on petanisejahtera.com; there is
 * no admin field for them yet. The footer keeps every policy Meta and Google
 * look for before they run a store's ads.
 */
import SiteBrand from './SiteBrand.astro';
import { getStorefrontProducts } from '../../../lib/catalog';
import { getStoreSupportWhatsapp } from '../../../lib/public-store';

const tenant = Astro.locals.tenant;
const [products, whatsappRaw] = await Promise.all([
  getStorefrontProducts(Astro.locals),
  getStoreSupportWhatsapp(Astro.locals),
]);
// Admin saves the number as typed; wa.me needs the international form.
const whatsapp = whatsappRaw.replace(/^0/, '62');
const whatsappLabel = whatsapp.startsWith('62')
  ? `+62 ${whatsapp.slice(2, 5)}-${whatsapp.slice(5, 9)}-${whatsapp.slice(9)}`
  : whatsapp;

const navigation = [
  { label: 'Semua Produk', href: '/produk' },
  { label: 'Solusi Terbaru', href: '/landing-page' },
  { label: 'Ulasan Petani', href: '/testimoni' },
  { label: 'Tentang Kami', href: '/tentang' },
];
const legal = [
  { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
  { label: 'Cookie & Iklan', href: '/kebijakan-cookie' },
  { label: 'Pengiriman & Retur', href: '/pengiriman' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Disclaimer', href: '/disclaimer' },
  { label: 'Sitemap Halaman', href: '/sitemap' },
];
const email = 'halo@petanisejahtera.id';
const office = ['Jl. Raya Darmo Permai No. 88', 'Surabaya Barat, Surabaya 60226', 'Jawa Timur, Indonesia'];

const titleClass = 'text-[11px] font-bold uppercase tracking-[0.16em] text-[#263238]';
const bodyClass = 'text-[12px] leading-6 text-[#616161]';
const linkClass = 'transition-colors hover:text-[#1B5E20] focus-visible:text-[#1B5E20] focus-visible:outline-none';
---

<footer class="relative overflow-hidden bg-[#FAFAFA] px-5 pb-6 pt-8 text-[#616161]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[4px] bg-gradient-to-r from-transparent via-[#1B5E20]/35 to-transparent" aria-hidden="true"></div>
  <span
    class="ps-display pointer-events-none absolute left-1/2 top-0 w-[115%] -translate-x-1/2 scale-x-[1.16] select-none text-center text-[clamp(108px,30vw,148px)] font-bold leading-none tracking-[-0.03em] text-[#E8EEE6]/90"
    aria-hidden="true">PJTS</span
  >

  <div class="relative z-10">
    <SiteBrand href="/" />
    <p class={`mt-3 max-w-[28rem] ${bodyClass}`}>
      Edukasi lapangan, rekomendasi nutrisi, dan panduan perawatan tanaman yang disusun praktis agar keputusan budidaya
      lebih tepat.
    </p>
  </div>

  <div class={`relative z-10 mt-6 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-[#E5E7EB] pt-6 ${bodyClass}`}>
    {products.length > 0 && (
      <div>
        <h2 class={titleClass}>Produk</h2>
        <ul class="mt-3 space-y-2.5">
          {products.map((product) => (
            <li><a href={`/produk/${product.slug}`} class={`uppercase ${linkClass}`}>{product.productName}</a></li>
          ))}
        </ul>
      </div>
    )}
    <div>
      <h2 class={titleClass}>Navigasi</h2>
      <ul class="mt-3 space-y-2.5">
        {navigation.map((item) => <li><a href={item.href} class={linkClass}>{item.label}</a></li>)}
      </ul>
    </div>
    <div class="col-span-2 border-t border-[#E5E7EB] pt-6">
      <h2 class={titleClass}>Legal & Informasi</h2>
      <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5">
        {legal.map((item) => <a href={item.href} class={linkClass}>{item.label}</a>)}
      </div>
    </div>
  </div>

  <div class="relative z-10 mt-6 border-t border-[#E5E7EB] pt-6">
    <h2 class={titleClass}>Kontak Resmi</h2>
    <div class="mt-3 grid grid-cols-2 gap-x-5 gap-y-5">
      {whatsapp && (
        <div>
          <p class="text-[12px] font-semibold leading-5 text-[#263238]">WhatsApp</p>
          <a href={`https://wa.me/${whatsapp}`} class={`mt-1 block ${bodyClass} ${linkClass}`} target="_blank" rel="nofollow noopener noreferrer">{whatsappLabel}</a>
        </div>
      )}
      <div>
        <p class="text-[12px] font-semibold leading-5 text-[#263238]">Email</p>
        <a href={`mailto:${email}`} class={`mt-1 block break-all ${bodyClass} ${linkClass}`}>{email}</a>
      </div>
      <div class="col-span-2 border-t border-[#E5E7EB] pt-4">
        <p class="text-[12px] font-semibold leading-5 text-[#263238]">Kantor Operasional</p>
        <div class="mt-1 space-y-0.5">{office.map((line) => <p class={bodyClass}>{line}</p>)}</div>
      </div>
    </div>
  </div>

  <p class="relative z-10 mt-6 border-t border-[#E5E7EB] pt-4 text-center text-[10px] text-[#616161]">
    © {new Date().getFullYear()} {tenant.name}. Hak cipta dilindungi.
  </p>
</footer>
