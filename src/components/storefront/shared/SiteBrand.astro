---
/**
 * Petani Sejahtera wordmark (install theme), ported from petanisejahtera.com:
 * the store's logo beside its name set as one word, the lead word in the deep
 * green and the rest a shade lighter, over the field-solution subline.
 *
 * Name and logo still resolve from the tenant, so the D1 store row stays the
 * one place a rename happens; only the visual treatment is this install's.
 */
import '../../../styles/petani-sejahtera.css';

interface Props {
  href?: string;
  class?: string;
  tone?: 'light' | 'dark';
}

const { href = '/', class: className = '', tone = 'dark' } = Astro.props;
const isLight = tone === 'light';
const tenant = Astro.locals.tenant;
const [leadWord = '', ...restWords] = tenant.name.trim().split(/\s+/);
const trailingWords = restWords.join('');
const subline = 'Solusi Nyata untuk Petani Indonesia';
---

<a
  href={href}
  class={`group flex min-w-0 items-center gap-[8px] ${className}`}
  aria-label={tenant.name}
  title={`${tenant.name} - ${subline}`}
>
  <img
    src={tenant.logo}
    alt=""
    class="h-[34px] w-[34px] flex-shrink-0 object-contain transition-opacity duration-200 group-hover:opacity-90"
    width="34"
    height="34"
    loading="eager"
    decoding="async"
  />
  <span class="flex min-w-0 flex-col justify-center">
    <span class="ps-display min-w-0 whitespace-nowrap text-[19px] font-bold leading-none tracking-[-0.02em]">
      <span class={isLight ? 'text-white' : 'text-[#1B5E20]'}>{leadWord}</span><span
        class={isLight ? 'text-white/90' : 'text-[#2E7D32]'}>{trailingWords}</span
      >
    </span>
    <span class={`mt-[4px] whitespace-nowrap text-[9px] leading-none tracking-[0.01em] ${isLight ? 'text-white/70' : 'text-[#616161]'}`}>
      {subline}
    </span>
  </span>
</a>
