---
/**
 * Policy and information page (install theme: Petani Sejahtera). Same
 * structure as the product's; the colours are written here because the
 * product's ui-variants tests pin its palette. A page may put content of its
 * own ahead of the sections through the default slot (the contact block).
 * Contacts and page names inside a paragraph are links (product
 * src/lib/legal-links.ts), styled in the install's green.
 */
import { legalSegments } from '../../../lib/legal-links';
import PageIntro from './PageIntro.astro';

interface LegalSection {
  title: string;
  paragraphs: string[];
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  badge: string;
  title: string;
  description: string;
  sections: LegalSection[];
  breadcrumbs?: BreadcrumbItem[];
}

const { badge, title, description, sections, breadcrumbs = [] } = Astro.props;
---

<main id="konten-utama" class="min-h-screen bg-white text-[#263238]">
  <PageIntro badge={badge} title={title} description={description} breadcrumbs={breadcrumbs} />

  <section class="mx-auto max-w-[480px] px-5 py-8">
    <slot />
    <div class="space-y-6">
      {
        sections.map((section) => (
          <article class="border-b border-[#E5E7EB] pb-6 last:border-b-0 last:pb-0">
            <h2 class="text-[18px] font-semibold tracking-[-0.01em] text-[#263238]">{section.title}</h2>
            <div class="mt-3 space-y-4 text-[14px] leading-7 text-[#4B5563]">
              {section.paragraphs.map((paragraph) => (
                <p>
                  {legalSegments(paragraph).map((segment) =>
                    segment.href ? (
                      <a
                        href={segment.href}
                        class="font-semibold text-[#1B5E20] underline underline-offset-4 hover:text-[#2E7D32] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B5E20]"
                        {...(segment.href.startsWith('https://') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        {segment.text}
                      </a>
                    ) : (
                      segment.text
                    ),
                  )}
                </p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</main>
