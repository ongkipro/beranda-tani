---
/**
 * Catalogue row (install theme: Petani Sejahtera), ported from
 * petanisejahtera.com's /produk list: thumbnail, green positioning line,
 * name, price with its strike-through, tag and variant count, and a link.
 * Only /produk renders it; the home grid has its own card.
 */
import { cardImageSrc } from '../../../lib/image-derivative';

interface ProductVariant {
  id?: string;
  label?: string;
  price?: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    category: string;
    tag?: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
  /** The first rows sit in the first viewport; loading them lazily delays LCP. */
  eager?: boolean;
}

const { product, formatPrice, eager = false } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
---

<article class="py-5">
  <a href={`/produk/${product.slug}`} class="group flex gap-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B5E20]">
    <img
      src={cardImageSrc(product.heroImage)}
      alt={`Foto produk ${product.productName}`}
      width="96"
      height="96"
      class="h-24 w-24 flex-shrink-0 object-cover"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#2E7D32]">{product.tag || product.category}</p>
          <h2 class="mt-1.5 text-[18px] font-bold leading-[1.35] text-[#263238]">{product.productName}</h2>
        </div>
        <div class="shrink-0 text-right">
          {hasDiscount && <p class="text-[11px] text-[#616161] line-through">{formatPrice(comparePrice)}</p>}
          <p class="text-[15px] font-bold text-[#1B5E20]">{formatPrice(product.price)}</p>
        </div>
      </div>
      <div class="mt-2.5 flex flex-wrap items-center gap-2 text-[11px] text-[#616161]">
        <span>{product.category}</span>
        <span class="h-1 w-1 rounded-full bg-[#F9A825]" aria-hidden="true"></span>
        <span>{product.variants.length} varian</span>
      </div>
      <p class="mt-2.5 text-[12px] font-semibold text-[#1B5E20]">Lihat Produk →</p>
    </div>
  </a>
</article>
